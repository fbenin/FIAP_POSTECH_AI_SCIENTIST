# LLM provider — pick one and fill in the corresponding key
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Groq (fast, free tier available — recommended for development)
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-70b-versatile

# Together AI
# LLM_PROVIDER=together
# TOGETHER_AI_API_KEY=...

# Ollama (local, no API key needed)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# Embedding (runs locally, no API key needed)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION=olist_reviews

# Retrieval — validated via experiments in notebooks/02_experimentos_rag.ipynb
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.75
