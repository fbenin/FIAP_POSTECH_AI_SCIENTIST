# Renomeie este arquivo para .env e preencha UMA das chaves abaixo.
# O notebook 03 detecta automaticamente qual provedor usar:
# se GROQ_API_KEY existir, usa Groq; caso contrário, usa OpenAI.

# Opção gratuita (recomendada) — crie em https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Opcional: sobrescreve o modelo Groq (padrão: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Opção paga — crie em https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

