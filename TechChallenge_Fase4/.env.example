# LLM provider — pick one and fill in the key
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Alternatives (comment out the one above and uncomment one below)
# LLM_PROVIDER=together
# TOGETHER_AI_API_KEY=...
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# Embedding (no API key needed, runs locally)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION=olist_reviews

# Retrieval
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.4
