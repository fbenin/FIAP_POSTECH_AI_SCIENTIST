# AWS Credentials — copie para .env e preencha
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# S3
S3_BUCKET_NAME=tech-challenge-alfabetizacao-01
S3_BRONZE_PREFIX=bronze
S3_SILVER_PREFIX=silver
S3_GOLD_PREFIX=gold

# Base dos Dados
BASEDOSDADOS_PROJECT_ID=

# Glue
GLUE_DATABASE=alfabetizacao_db
GLUE_IAM_ROLE=arn:aws:iam::551504153439:role/GlueServiceRole

# Athena
ATHENA_OUTPUT_LOCATION=s3://tech-challenge-alfabetizacao-01/athena-results/

USE_AWS=true
